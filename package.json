{
  "name": "wurst",
  "version": "0.0.1",
  "private": true,
  "description": "WÜRST is a local-first engineering platform. It's de WURST.",
  "keywords": [
    "ide",
    "ai",
    "cursor",
    "claude"
  ],
  "homepage": "https://github.com/joyoflifting/wurst#readme",
  "bugs": {
    "url": "https://github.com/joyoflifting/wurst/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyoflifting/wurst.git"
  },
  "license": "ISC",
  "author": "Nick Baker",
  "type": "commonjs",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.preview.config.mts",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/application/tsconfig.json --noEmit && tsc -p packages/presentation/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.preview.json --noEmit",
    "test": "vitest run",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
